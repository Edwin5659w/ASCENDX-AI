{
  "name": "ascendx-ai",
  "version": "0.2.0",
  "private": true,
  "description": "ASCENDX AI — monorepo: apps/api, apps/mobile y packages/finance-core.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "start": "node scripts/arrancar.mjs",
    "apk": "cd apps/mobile && npx eas-cli build --platform android --profile preview",
    "local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/iniciar.ps1",
    "stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/detener.ps1",
    "build:core": "npm run build -w @ascendx/finance-core",
    "api": "npm run dev -w @ascendx/api",
    "app": "npm run start -w @ascendx/mobile",
    "test": "npm run test -w @ascendx/finance-core && npm run test -w @ascendx/api",
    "test:coverage": "npm run test:coverage -w @ascendx/finance-core",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint -w @ascendx/mobile"
  },
  "engines": {
    "node": ">=20"
  }
}
