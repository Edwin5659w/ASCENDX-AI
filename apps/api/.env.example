# Entorno: development | test | production
NODE_ENV=development
PORT=4000

# PostgreSQL (local o en la nube). Ejemplo local:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ascendx?schema=public"

# Secreto para firmar los tokens de acceso (mínimo 32 caracteres, aleatorio).
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Duraciones
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Orígenes permitidos para CORS separados por coma (la app móvil no los necesita)
CORS_ORIGINS=http://localhost:8081

# Nivel de logs: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Asistente de IA (RF-23 a RF-26). «local» = explicaciones con reglas, sin
# enviar datos a terceros. Para un modelo externo: anthropic u openai.
AI_PROVIDER=local
# AI_API_KEY=            # obligatoria si AI_PROVIDER no es local (nunca en el repositorio)
# AI_MODEL=              # opcional: claude-haiku-4-5 / gpt-4o-mini por defecto
# AI_BASE_URL=           # opcional: API compatible con OpenAI en otra dirección
# AI_TIMEOUT_MS=15000
