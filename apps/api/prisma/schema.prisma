// ASCENDX AI — Modelo de datos v2 (Documento Maestro v2, sección 10)
//
// Convenciones:
// - Tablas y columnas en snake_case (@@map / @map); modelos en PascalCase.
// - Dinero en pesos colombianos ENTEROS (BIGINT). Tasas en DECIMAL(9,6) como fracción (0.245 = 24,5 %). Nunca float.
// - Todo registro del usuario tiene user_id y se borra en cascada al eliminar la cuenta (RF-05).
// - deleted_at = borrado lógico para que la eliminación también se sincronice (sección 13).
// - client_op_id = identificador generado en el teléfono; único por usuario para que un reintento no duplique (RNF-12).
// - Los valores de los enums coinciden con los tipos de packages/finance-core.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Enumeraciones ─────────────────────────

/// Sección 6.1
enum TransactionType {
  ingreso
  gasto
  pago_deuda
  aporte_meta
  retiro_meta
}

enum CategoryKind {
  ingreso
  gasto
}

enum TransactionSource {
  manual
  ocr
  recurrente
}

/// EA = efectiva anual; MV = mensual vencida
enum RateType {
  EA
  MV
}

enum DebtStatus {
  activa
  pagada
  cancelada
}

enum GoalPriority {
  alta
  media
  baja
}

enum GoalStatus {
  activa
  pausada
  completada
  cancelada
}

enum ConsentType {
  terminos
  datos
  ia
  ocr
}

enum ReceiptStatus {
  extraido
  confirmado
  descartado
}

enum AccountKind {
  efectivo
  banco
  billetera
}

enum RecurrenceFrequency {
  semanal
  quincenal
  mensual
}

enum AiMessageRole {
  user
  assistant
}

// ───────────────────────── Cuenta, sesiones y consentimientos ─────────────────────────

model User {
  id                  String    @id @default(uuid()) @db.Uuid
  email               String    @unique
  passwordHash        String    @map("password_hash")
  name                String    @db.VarChar(80)
  /// Declaración de mayoría de edad en el registro (sección 4)
  isAdult             Boolean   @map("is_adult")
  emailVerifiedAt     DateTime? @map("email_verified_at")
  /// RF-02: intentos fallidos seguidos y bloqueo temporal de 15 min
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  sessions              Session[]
  passwordResets        PasswordReset[]
  consents              Consent[]
  financialProfile      FinancialProfile?
  categories            Category[]
  transactions          Transaction[]
  debts                 Debt[]
  goals                 FinancialGoal[]
  goalContributions     GoalContribution[]
  creditScenarios       CreditScenario[]
  aiConversations       AiConversation[]
  aiUsage               AiUsage[]
  receipts              Receipt[]
  accounts              Account[]
  recurringTransactions RecurringTransaction[]
  achievements          UserAchievement[]

  @@map("users")
}

/// Sesión por dispositivo. Solo se guarda el hash del token de renovación; rota en cada uso.
model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash")
  deviceName       String?   @map("device_name") @db.VarChar(80)
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  replacedById     String?   @map("replaced_by_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// RF-03: código de 6 dígitos (solo su hash), válido 15 min, máximo 5 intentos, un solo uso.
model PasswordReset {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash")
  expiresAt DateTime  @map("expires_at")
  attempts  Int       @default(0)
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("password_resets")
}

/// Ley 1581 de 2012: autorización previa, expresa e informada, con la versión del texto aceptado.
model Consent {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  type      ConsentType
  version   String      @db.VarChar(20)
  grantedAt DateTime    @default(now()) @map("granted_at")
  revokedAt DateTime?   @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("consents")
}

model FinancialProfile {
  id                     String   @id @default(uuid()) @db.Uuid
  userId                 String   @unique @map("user_id") @db.Uuid
  estimatedIncome        BigInt?  @map("estimated_income")
  estimatedFixedExpenses BigInt?  @map("estimated_fixed_expenses")
  /// Día del mes en que recibe el ingreso principal (1–31)
  payDay                 Int?     @map("pay_day")
  /// Fracción de la capacidad que se considera prudente (sección 6.2)
  safetyMargin           Decimal  @default(0.8) @map("safety_margin") @db.Decimal(3, 2)
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("financial_profiles")
}

// ───────────────────────── Movimientos ─────────────────────────

/// user_id null = categoría por defecto del sistema. Con movimientos se archiva, no se borra (RF-10).
model Category {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String?      @map("user_id") @db.Uuid
  name       String       @db.VarChar(60)
  kind       CategoryKind
  icon       String?      @db.VarChar(40)
  color      String?      @db.VarChar(9)
  isDefault  Boolean      @default(false) @map("is_default")
  archivedAt DateTime?    @map("archived_at")
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  user                  User?                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions          Transaction[]
  recurringTransactions RecurringTransaction[]

  @@unique([userId, name, kind])
  @@map("categories")
}

model Transaction {
  id              String            @id @default(uuid()) @db.Uuid
  userId          String            @map("user_id") @db.Uuid
  type            TransactionType
  amount          BigInt
  date            DateTime          @db.Date
  categoryId      String?           @map("category_id") @db.Uuid
  description     String?           @db.VarChar(200)
  debtId          String?           @map("debt_id") @db.Uuid
  goalId          String?           @map("goal_id") @db.Uuid
  accountId       String?           @map("account_id") @db.Uuid
  source          TransactionSource @default(manual)
  /// RF-12: en un pago de deuda, parte que abonó a capital y parte de intereses
  principalAmount BigInt?           @map("principal_amount")
  interestAmount  BigInt?           @map("interest_amount")
  clientOpId      String?           @map("client_op_id") @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  deletedAt       DateTime?         @map("deleted_at")

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  category         Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  debt             Debt?             @relation(fields: [debtId], references: [id], onDelete: SetNull)
  goal             FinancialGoal?    @relation(fields: [goalId], references: [id], onDelete: SetNull)
  account          Account?          @relation(fields: [accountId], references: [id], onDelete: SetNull)
  goalContribution GoalContribution?
  receipt          Receipt?

  @@unique([userId, clientOpId])
  @@index([userId, date])
  @@index([userId, type, date])
  @@index([userId, updatedAt])
  @@map("transactions")
}

// ───────────────────────── Deudas ─────────────────────────

model Debt {
  id             String     @id @default(uuid()) @db.Uuid
  userId         String     @map("user_id") @db.Uuid
  creditor       String     @db.VarChar(80)
  name           String?    @db.VarChar(80)
  originalAmount BigInt     @map("original_amount")
  balance        BigInt
  rate           Decimal?   @db.Decimal(9, 6)
  rateType       RateType?  @map("rate_type")
  installment    BigInt?
  termMonths     Int?       @map("term_months")
  /// Día del mes en que vence la cuota (1–31)
  paymentDay     Int?       @map("payment_day")
  status         DebtStatus @default(activa)
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  deletedAt      DateTime?  @map("deleted_at")

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments Transaction[]

  @@index([userId, status])
  @@map("debts")
}

// ───────────────────────── Metas ─────────────────────────

model FinancialGoal {
  id              String       @id @default(uuid()) @db.Uuid
  userId          String       @map("user_id") @db.Uuid
  name            String       @db.VarChar(80)
  targetAmount    BigInt       @map("target_amount")
  /// Se recalcula en la misma transacción que crea el aporte o retiro
  savedAmount     BigInt       @default(0) @map("saved_amount")
  targetDate      DateTime?    @map("target_date") @db.Date
  priority        GoalPriority @default(media)
  icon            String?      @db.VarChar(40)
  status          GoalStatus   @default(activa)
  /// Marca la meta que cuenta como fondo de emergencia (sección 6.2)
  isEmergencyFund Boolean      @default(false) @map("is_emergency_fund")
  completedAt     DateTime?    @map("completed_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  deletedAt       DateTime?    @map("deleted_at")

  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  contributions   GoalContribution[]
  transactions    Transaction[]
  creditScenarios CreditScenario[]

  @@index([userId, status])
  @@map("financial_goals")
}

/// Aporte (monto positivo) o retiro (monto negativo) de una meta, ligado a su movimiento.
model GoalContribution {
  id            String   @id @default(uuid()) @db.Uuid
  goalId        String   @map("goal_id") @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  transactionId String?  @unique @map("transaction_id") @db.Uuid
  amount        BigInt
  createdAt     DateTime @default(now()) @map("created_at")

  goal        FinancialGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction Transaction?  @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([goalId, createdAt])
  @@map("goal_contributions")
}

// ───────────────────────── Simulador ─────────────────────────

/// RF-22: escenario guardado con sus entradas, resultados y la versión del motor de cálculo.
model CreditScenario {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  goalId        String?  @map("goal_id") @db.Uuid
  name          String   @db.VarChar(80)
  inputs        Json
  results       Json
  engineVersion String   @map("engine_version") @db.VarChar(20)
  createdAt     DateTime @default(now()) @map("created_at")

  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal FinancialGoal? @relation(fields: [goalId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("credit_scenarios")
}

// ───────────────────────── IA ─────────────────────────

model AiConversation {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  title     String   @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AiMessage[]

  @@index([userId, updatedAt])
  @@map("ai_conversations")
}

model AiMessage {
  id             String        @id @default(uuid()) @db.Uuid
  conversationId String        @map("conversation_id") @db.Uuid
  role           AiMessageRole
  content        String
  tokens         Int?
  /// Respuesta estructurada, datos usados y resultado de la verificación de cifras
  meta           Json?
  createdAt      DateTime      @default(now()) @map("created_at")

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

/// RNF-11: registro de cada solicitud a la IA para los límites diarios y el tope mensual de gasto.
model AiUsage {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  /// resumen | plan | chat
  kind      String   @db.VarChar(20)
  provider  String   @db.VarChar(30)
  tokens    Int      @default(0)
  verified  Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, createdAt])
  @@index([createdAt])
  @@map("ai_usage")
}

// ───────────────────────── P2: OCR, cuentas, recurrentes, logros ─────────────────────────

/// Datos extraídos de un recibo. La imagen nunca se guarda (sección 12).
model Receipt {
  id            String        @id @default(uuid()) @db.Uuid
  userId        String        @map("user_id") @db.Uuid
  merchant      String?       @db.VarChar(120)
  date          DateTime?     @db.Date
  total         BigInt?
  status        ReceiptStatus @default(extraido)
  transactionId String?       @unique @map("transaction_id") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@map("receipts")
}

model Account {
  id             String      @id @default(uuid()) @db.Uuid
  userId         String      @map("user_id") @db.Uuid
  name           String      @db.VarChar(60)
  kind           AccountKind
  initialBalance BigInt      @default(0) @map("initial_balance")
  archivedAt     DateTime?   @map("archived_at")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions          Transaction[]
  recurringTransactions RecurringTransaction[]

  @@index([userId])
  @@map("accounts")
}

model RecurringTransaction {
  id          String              @id @default(uuid()) @db.Uuid
  userId      String              @map("user_id") @db.Uuid
  type        TransactionType
  amount      BigInt
  categoryId  String?             @map("category_id") @db.Uuid
  description String?             @db.VarChar(200)
  frequency   RecurrenceFrequency
  /// Día del mes que se respeta en meses cortos (31 → 28 → 31)
  anchorDay   Int?                @map("anchor_day") @db.SmallInt
  accountId   String?             @map("account_id") @db.Uuid
  nextDate    DateTime            @map("next_date") @db.Date
  active      Boolean             @default(true)
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  account  Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([userId, nextDate])
  @@map("recurring_transactions")
}

model UserAchievement {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  achievementCode String   @map("achievement_code") @db.VarChar(60)
  earnedAt        DateTime @default(now()) @map("earned_at")
  metadata        Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementCode])
  @@map("user_achievements")
}

// ───────────────────────── Configuración global ─────────────────────────

/// Una sola fila (id = 1). La tasa de usura se actualiza a mano con su fecha.
model AppSettings {
  id                  Int       @id @default(1)
  usuryRateReference  Decimal?  @map("usury_rate_reference") @db.Decimal(9, 6)
  usuryRateDate       DateTime? @map("usury_rate_date") @db.Date
  aiDailyChatLimit    Int       @default(20) @map("ai_daily_chat_limit")
  aiDailySummaryLimit Int       @default(5) @map("ai_daily_summary_limit")
  /// Tope mensual de tokens para todos los usuarios (RNF-11); 0 = sin tope
  aiMonthlyTokenLimit Int       @default(2000000) @map("ai_monthly_token_limit")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@map("app_settings")
}
